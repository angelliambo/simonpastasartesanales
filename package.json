{
  "name": "mern-saas-factory-framework",
  "version": "1.0.0",
  "private": true,
  "description": "MERN SaaS Factory Framework - Modular Monorepo Boilerplate",
  "workspaces": [
    "packages/portal",
    "packages/portal/backend",
    "packages/portal/frontend",
    "packages/shared"
  ],
  "scripts": {
    "build": "pnpm --filter @factory/shared build && pnpm --filter @factory/backend build && pnpm --filter @factory/frontend build",
    "shared:build": "pnpm --filter @factory/shared build",
    "portal:build": "pnpm --filter @factory/backend build && pnpm --filter @factory/frontend build",
    "dev:backend": "pnpm --filter @factory/backend dev",
    "dev:frontend": "pnpm --filter @factory/frontend dev",
    "cleanup": "pnpm --filter @factory/shared run clean && pnpm --filter @factory/backend run clean && pnpm --filter @factory/frontend run clean && rm -rf node_modules pnpm-lock.yaml",
    "shared:cleanup": "pnpm --filter @factory/shared run clean",
    "portal:cleanup": "pnpm --filter @factory/backend run clean && pnpm --filter @factory/frontend run clean",
    "reset": "pnpm cleanup && pnpm install && pnpm build",
    "deploy": "cd packages/portal && pnpm fdeploy",
    "bump": "node scripts/version-bump.js",
    "gp": "node scripts/gp.js",
    "free-ports": "node scripts/free-ports.js",
    "gen-key": "node scripts/generate-env-keys.js",
    "audit:i18n": "pnpm --filter @factory/shared audit:i18n",
    "audit:performance": "node scripts/audit-portal.js",
    "audit:wording": "node scripts/audit-wording.js",
    "update-seo": "pnpm --filter @factory/frontend update-seo",
    "test-email": "pnpm --filter @factory/backend test-email",
    "analytics:extract": "tsx scripts/analytics-optimizer/index.ts",
    "analytics:digest": "tsx scripts/analytics-optimizer/index.ts --export-format=md",
    "audit:seo": "npx tsx scripts/audit-seo-landings.ts",
    "inspect:gsc": "tsx scripts/inspect-gsc.ts",
    "setup:ga4": "tsx scripts/setup-ga4-conversions.ts",
    "submit:sitemap": "tsx scripts/submit-sitemap-gsc.ts",
    "submit:indexation": "tsx scripts/submit-prod-indexation.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@google-analytics/data": "^4.11.0",
    "@types/node": "^22.10.0",
    "googleapis": "^176.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
