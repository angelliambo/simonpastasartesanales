# =========================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO PARA EL PORTAL WEB (FRONTEND)
# Copia este archivo como '.env', '.env.development' o '.env.production'
# y completa los valores con tus credenciales reales.
# =========================================================================

# URL del backend (Local: http://localhost:5000/api | Producción: https://tu-dominio.com/api)
VITE_API_URL=http://localhost:5000/api

# Client ID de Google OAuth 2.0 (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=tu_client_id_de_google_oauth

# ID de Google Analytics (GA4 - Ej: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=tu_ga_measurement_id

# Google Maps API Key (Para el mapa interactivo de contacto)
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# Configuración del SDK de Firebase
# (Se inicializará Firebase Analytics automáticamente si se definen estas variables)
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto_firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_firebase
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto_firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=tu_firebase_measurement_id

# Google AdSense y Monetización
VITE_ADS_ENABLED=true
VITE_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_HOME_SUBHERO=1000000001
VITE_ADSENSE_SLOT_HOME_FOOTER=1000000002
VITE_ADSENSE_SLOT_LANDING_CONTENT=1000000003

# Google Search Console y GA4 Property
GSC_SITE_DOMAIN=tu-dominio.com
GA4_PROPERTY_ID=123456789
GCP_SERVICE_ACCOUNT_PATH=credentials/gcp-service-account.json
