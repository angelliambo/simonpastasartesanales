{
  "name": "@factory/frontend",
  "version": "1.6.4",
  "proxy": "http://localhost:5000",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@factory/shared": "workspace:*",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "antd": "^5.26.6",
    "firebase": "^10.12.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.1",
    "styled-components": "^6.1.19",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/jest-dom": "6.6.3",
    "@types/babel__core": "^7.20.5",
    "@types/body-parser": "^1.19.6",
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "identity-obj-proxy": "^3.0.0",
    "sharp": "0.35.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0"
  },
  "scripts": {
    "update-seo": "npx tsx scripts/update-seo.ts",
    "optimize-og": "npx tsx scripts/optimize-og.ts",
    "prerender": "npx tsx scripts/prerender.ts",
    "clean": "rm -rf build dist node_modules",
    "start": "vite --port 3000",
    "dev": "vite --port 3000",
    "build": "vite build && npx tsx scripts/prerender.ts",
    "preview": "vite preview",
    "analyze": "ANALYZE=true vite build",
    "test": "jest --watch=false --runInBand",
    "test:ci": "jest --watch=false --runInBand",
    "test:watch": "jest --watch",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/**/*.{ts,tsx}\"",
    "gp": "node ../../../scripts/gp.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../shared/src/$1",
      "^@design-sys/(.*)$": "<rootDir>/../../shared/src/design-sys/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  }
}
